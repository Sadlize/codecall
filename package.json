{
  "name": "wizardry",
  "author": "Alexey Pautov-Brevnov <alexey.pautovbrevnov@gmail.com>",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port=3000",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write {app,src}/**/*.{ts,tsx}",
    "typecheck": "react-router typegen && tsc --noEmit",
    "commit": "cz",
    "prepare": "husky install",
    "fsd": "steiger ./src"
  },
  "dependencies": {
    "@react-router/fs-routes": "7.6.2",
    "@react-router/node": "7.6.2",
    "@react-router/serve": "7.6.2",
    "isbot": "5.1.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.1",
    "@commitlint/config-conventional": "19.6.0",
    "@commitlint/cz-commitlint": "19.6.1",
    "@feature-sliced/steiger-plugin": "0.5.6",
    "@react-router/dev": "7.6.2",
    "@tailwindcss/postcss": "4.0.9",
    "@types/node": "22.10.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.3.4",
    "commitizen": "4.3.1",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-config-wizardry": "0.5.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "postcss": "8.5.3",
    "prettier": "3.4.2",
    "steiger": "0.5.7",
    "tailwindcss": "4.0.9",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.7.2",
    "vite": "6.3.5",
    "vite-tsconfig-paths": "5.1.4"
  }
}