{
  "name": "codecall",
  "author": "Alexey Pautov-Brevnov <alexey.pautovbrevnov@gmail.com>",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write frontend/{app,src}/**/*.{ts,tsx}",
    "commit": "cz",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@commitlint/cz-commitlint": "20.1.0",
    "commitizen": "4.3.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-wizardry": "0.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
